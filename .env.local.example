# ================================================
# Supabase
# ================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ================================================
# Google Drive 백업 (슈퍼관리자 1명만 사용)
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# 승인된 리디렉션 URI 에 ${NEXT_PUBLIC_SITE_URL}/api/auth/google-drive/callback 등록 필수
# ================================================
GOOGLE_OAUTH_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxx

# Google Drive Picker — 사용자가 백업 폴더를 직접 선택하기 위해 필요
# Google Cloud Console > APIs & Services >
#   1) Library 에서 "Google Picker API" 활성화
#   2) Credentials > Create credentials > API key — 새 API 키 발급
#   3) API restrictions 에서 Google Picker API 만 허용으로 제한
# NEXT_PUBLIC_ 접두사라 클라이언트 노출됨 — Picker API 만 허용된 키만 사용할 것
NEXT_PUBLIC_GOOGLE_API_KEY=AIzaxxxxxxxxxxxx

# ================================================
# Vercel Cron 인증 (주간 자동 백업)
# 32자 이상의 무작위 문자열 권장:  openssl rand -hex 32
# Vercel 대시보드의 Environment Variables 에도 동일 값 등록
# ================================================
CRON_SECRET=

# ================================================
# 사이트 URL (OAuth redirect_uri 산정 등)
# ================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
